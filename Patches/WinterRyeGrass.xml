<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<success>Normal</success>
		<operations>
			
			<!-- Winter RyeGrass -->
		
			<li Class="PatchOperationAdd">
				<xpath>/Defs</xpath>
				<value>
					
					<ThingDef ParentName="PlantBase">
						<defName>WinterRyeGrass</defName>
						<label>Winter RyeGrass</label>
						<description>Winter RyeGrass is a fast growing pasture grass generally planted in the fall or early winter. It is cold hardy, and can survive through all but the harshest of winters and serve as a steady source of animal grazing grass when no other plants are growing on the map.
						
Winter RyeGrass can not be planted if the temperature is below -20°C since the ground will be frozen, and it has an optimal growing temperature range of -25°C to 15°C.</description>
						<thingClass>ExpandablePlants.Plant</thingClass>
						<statBases>
							<MaxHitPoints>85</MaxHitPoints>
							<Flammability>1.3</Flammability>
							<Nutrition>0.50</Nutrition>
						</statBases>
						<graphicData>
							<texPath>Things/Plant/Grass</texPath>
							<graphicClass>Graphic_Random</graphicClass>
						</graphicData>
						<ingestible/>
						<plant>
							<sowTags>
								<li>Ground</li>
							</sowTags>
							<fertilityMin>0.05</fertilityMin>
							<fertilitySensitivity>1</fertilitySensitivity>
							<growDays>2.5</growDays>
							<lifespanDaysPerGrowDays>48</lifespanDaysPerGrowDays>
							<neverBlightable>true</neverBlightable>
							<leaflessGraphicPath>Things/Plant/Grass_Leafless</leaflessGraphicPath>
							<harvestWork>40</harvestWork>
							<maxMeshCount>9</maxMeshCount>
							<visualSizeRange>0.3~0.9</visualSizeRange>
							<topWindExposure>0.4</topWindExposure>
							<pollutedGraphicPath>Things/Plant/Grass_Polluted</pollutedGraphicPath>
						</plant>
						<comps>
							<li Class="ExpandablePlants.CompProperties_Plant">
								<maxGrowthTemperature>25</maxGrowthTemperature>
								<maxOptimalGrowthTemperature>15</maxOptimalGrowthTemperature>
								<minOptimalGrowthTemperature>-25</minOptimalGrowthTemperature>
								<maxLeaflessTemperature>-27</maxLeaflessTemperature>
								<minGrowthTemperature>-35</minGrowthTemperature>
								<minLeaflessTemperature>-50</minLeaflessTemperature>
								<restBegins>19</restBegins>
								<restEnds>5</restEnds>
							</li>
						</comps>
					</ThingDef>
					
				</value>
			</li>
			
			<!-- Dark Winter RyeGrass -->
			
			<li Class="PatchOperationAdd">
				<xpath>/Defs</xpath>
				<value>
					
					<ThingDef ParentName="CavePlantBase">
						<defName>DarkWinterRyeGrass</defName>
						<label>Dark Winter RyeGrass</label>
						<description>Dark Winter RyeGrass is a fast growing grass adapted for growth in no-sunlight conditions, and is generally planted in the fall or early winter. It is cold hardy, and can survive through all but the harshest of winters and serve as a steady source of animal grazing grass when no other plants are growing on the map.
						
Dark Winter RyeGrass can not be planted if the temperature is below -20°C, since the ground will be frozen. It has an optimal growing temperature range of -25°C to 15°C and will die if it is exposed to light.</description>
						<thingClass>ExpandablePlants.Plant</thingClass>
						<statBases>
							<MaxHitPoints>65</MaxHitPoints>
							<Flammability>0.5</Flammability>
							<Nutrition>0.50</Nutrition>
						</statBases>
						<graphicData>
							<texPath>Things/Plant/Grass</texPath>
							<graphicClass>Graphic_Random</graphicClass>
							<drawSize>1.4</drawSize>
						</graphicData>
						<uiIconScale>0.715</uiIconScale>
						<ingestible/>
						<plant>
							<sowTags>
								<li>Ground</li>
							</sowTags>
							<fertilityMin>0.05</fertilityMin>
							<fertilitySensitivity>1</fertilitySensitivity>
							<growDays>2.5</growDays>
							<lifespanDaysPerGrowDays>48</lifespanDaysPerGrowDays>
							<neverBlightable>true</neverBlightable>
							<harvestWork>40</harvestWork>
							<maxMeshCount>9</maxMeshCount>
							<visualSizeRange>0.3~0.9</visualSizeRange>
							<topWindExposure>0.4</topWindExposure>
							<pollution>Any</pollution>
							<growMinGlow>0</growMinGlow>
							<growOptimalGlow>0</growOptimalGlow>
							<diesToLight>true</diesToLight>
						</plant>
						<comps>
							<li Class="ExpandablePlants.CompProperties_Plant">
								<maxGrowthTemperature>25</maxGrowthTemperature>
								<maxOptimalGrowthTemperature>15</maxOptimalGrowthTemperature>
								<minOptimalGrowthTemperature>-25</minOptimalGrowthTemperature>
								<maxLeaflessTemperature>-27</maxLeaflessTemperature>
								<minGrowthTemperature>-35</minGrowthTemperature>
								<minLeaflessTemperature>-50</minLeaflessTemperature>
								<restBegins>19</restBegins>
								<restEnds>5</restEnds>
							</li>
						</comps>
					</ThingDef>
					
				</value>
			</li>
				
			<!-- Use Nightgrass texture if Odyssey is present -->
			
			<li Class="PatchOperationReplace" MayRequire="Ludeon.RimWorld.Odyssey">
				<xpath>
        /Defs/ThingDef[defName="DarkWinterRyeGrass"]/graphicData/texPath
				</xpath>
				<value>
					<texPath>Things/Plant/Nightgrass</texPath>
				</value>
			</li>
			
